// Prisma 7 schema. URL is supplied via prisma.config.ts (datasource.url = env DATABASE_URL).
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider           = "prisma-client"
  output             = "../generated/prisma"
  runtime            = "nodejs"
  moduleFormat       = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
enum Role {
  USER
  ORGANIZER
  ADMIN
}

enum Gender {
  WOMAN
  MAN
  UNDISCLOSED
}

enum GenderTrack {
  WOMEN_ONLY
  MEN_ONLY
  MIXED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Language {
  URDU
  ENGLISH
  BOTH
}

enum LifeStage {
  STUDENT
  EARLY_CAREER
  PROFESSIONAL
  BUSINESS_OWNER
  PARENT
  OTHER
}

enum SocialEnergy {
  LISTENER
  MIX
  INITIATOR
}

enum Intent {
  MAKE_FRIENDS
  MEET_OUTSIDE_BUBBLE
  NETWORKING
  NEW_TO_CITY
  PRACTICE_ENGLISH
}

enum BeveragePref {
  COFFEE
  CHAI
  EITHER
}

enum EventStatus {
  DRAFT
  OPEN
  FULL
  CLOSED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum AttendanceStatus {
  BOOKED
  ATTENDED
  NO_SHOW
}

enum BookingStatus {
  ACTIVE
  WAITLISTED
  CANCELLED
}

enum MeetAgain {
  ALL
  SOME
  NO
}

enum GroupFeel {
  TOO_SIMILAR
  JUST_RIGHT
  TOO_DIFFERENT
}

enum SizeFeel {
  TOO_SMALL
  JUST_RIGHT
  TOO_BIG
}

enum ComeAgain {
  YES
  MAYBE
  NO
}

// ---------- Models ----------
model User {
  id                 String             @id @default(cuid())
  phone              String             @unique
  role               Role               @default(USER)
  canHost            Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  cnicImagePath      String?
  reliabilityScore   Int                @default(100)

  // Profile (§12 intake)
  firstName          String?
  lastInitial        String?
  ageBand            String?
  gender             Gender?
  city               String?
  areas              String[]
  language           Language?
  availability       String[]
  interests          String[]
  lifeStage          LifeStage?
  socialEnergy       SocialEnergy?
  intents            Intent[]
  newcomerStatus     String?
  beveragePref       BeveragePref?
  accessibilityNeeds String?
  occupation         String?
  photoUrl           String?
  photoConsent       Boolean            @default(false)
  codeOfConductAt    DateTime?

  blockedUserIds     String[]
  savedTableIds      String[]

  // Referrals — each user has a shareable code; new signups may carry one.
  referralCode       String?            @unique
  referredByCode     String?

  bookings           Booking[]
  feedback           Feedback[]
  reportsMade        Report[]           @relation("ReportsMade")
  reportsAgainst     Report[]           @relation("ReportsAgainst")
  hostedTables       Table[]            @relation("HostedTables")
  connectionsSent    Connection[]       @relation("ConnRequester")
  connectionsReceived Connection[]      @relation("ConnAddressee")
  dmSent             DirectMessage[]    @relation("DmSender")
  dmReceived         DirectMessage[]    @relation("DmRecipient")
  invitesSent        TableInvite[]      @relation("InvitesSent")
  invitesReceived    TableInvite[]      @relation("InvitesReceived")

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Cafe {
  id            String   @id @default(cuid())
  name          String
  area          String
  address       String?
  lat           Float?
  lng           Float?
  deadHourSlots String[]
  compTerms     String?
  events        Event[]
  tables        Table[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------- Tables (host-created; approval-based join) ----------
enum TableStatus {
  OPEN
  FULL
  CLOSED
  CANCELLED
  COMPLETED
}

enum JoinStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  MAYBE
}

model Table {
  id           String             @id @default(cuid())
  host         User               @relation("HostedTables", fields: [hostId], references: [id])
  hostId       String
  cafe         Cafe?              @relation(fields: [cafeId], references: [id])
  cafeId       String?
  venueName    String?
  venueAddress String?
  lat          Float?
  lng          Float?
  title        String?
  startAt      DateTime
  seats        Int
  seatsLeft    Int
  category     String
  description  String?
  imageUrl     String? // cover photo; falls back to a category cover when null
  rules        String?
  pricePKR     Int? // null = free
  status       TableStatus        @default(OPEN)

  requests     TableJoinRequest[]
  invites      TableInvite[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, startAt])
  @@index([hostId])
}

enum ReviewRole {
  HOST
  GUEST
}

model Review {
  id         String     @id @default(cuid())
  tableId    String
  reviewerId String
  subjectId  String // the user being rated
  role       ReviewRole // capacity the subject served (HOST or GUEST)
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime   @default(now())

  @@unique([tableId, reviewerId, subjectId])
  @@index([subjectId, role])
  @@index([tableId])
}

model TableJoinRequest {
  id            String        @id @default(cuid())
  table         Table         @relation(fields: [tableId], references: [id])
  tableId       String
  userId        String
  status        JoinStatus    @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING) // for paid tables, after approval
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tableId, userId])
  @@index([tableId, status])
  @@index([userId])
}

model Event {
  id          String            @id @default(cuid())
  cafe        Cafe              @relation(fields: [cafeId], references: [id])
  cafeId      String
  title       String?
  startAt     DateTime
  genderTrack GenderTrack
  area        String
  capacity    Int
  pricePKR    Int
  seatsLeft   Int
  status      EventStatus       @default(OPEN)

  // Optional one-off location — overrides the cafe on the map + detail when set.
  venueName    String?
  venueAddress String?
  lat          Float?
  lng          Float?

  bookings    Booking[]
  groups      GroupAssignment[]
  feedback    Feedback[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, startAt])
  @@index([area, genderTrack])
}

model Booking {
  id               String           @id @default(cuid())
  user             User             @relation(fields: [userId], references: [id])
  userId           String
  event            Event            @relation(fields: [eventId], references: [id])
  eventId          String
  paymentStatus    PaymentStatus    @default(PENDING)
  attendanceStatus AttendanceStatus @default(BOOKED)
  status           BookingStatus    @default(ACTIVE)
  amountPKR        Int
  paymentRef       String?          @unique
  cancelledAt      DateTime?
  waitlistedAt     DateTime?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, eventId])
  @@index([eventId, paymentStatus])
  @@index([eventId, status, waitlistedAt])
}

model GroupAssignment {
  id         String   @id @default(cuid())
  event      Event    @relation(fields: [eventId], references: [id])
  eventId    String
  userIds    String[]
  matchScore Float?
  algoVersion String  @default("manual")
  createdAt  DateTime @default(now())

  @@index([eventId])
}

model Feedback {
  id             String     @id @default(cuid())
  user           User       @relation(fields: [userId], references: [id])
  userId         String
  event          Event      @relation(fields: [eventId], references: [id])
  eventId        String
  enjoyment      Int // 1-5
  meetAgain      MeetAgain
  seeAgainNames  String?
  mixFelt        GroupFeel
  sizeFelt       SizeFeel
  cafeRating     Int // 1-5
  comeAgain      ComeAgain
  inviteFriend   Boolean
  nps            Int // 0-10
  feltUnsafe     Boolean    @default(false)
  unsafeDetails  String?
  improve        String?
  createdAt      DateTime   @default(now())

  @@unique([userId, eventId])
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  body      String
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  meta      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

model Report {
  id           String   @id @default(cuid())
  reporter     User     @relation("ReportsMade", fields: [reporterId], references: [id])
  reporterId   String
  subject      User     @relation("ReportsAgainst", fields: [subjectId], references: [id])
  subjectId    String
  eventId      String?
  reason       String
  createdAt    DateTime @default(now())

  @@index([subjectId])
}

model Connection {
  id           String           @id @default(cuid())
  requester    User             @relation("ConnRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId  String
  addressee    User             @relation("ConnAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  addresseeId  String
  status       ConnectionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@index([requesterId])
}

model DirectMessage {
  id           String    @id @default(cuid())
  sender       User      @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId     String
  recipient    User      @relation("DmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId  String
  body         String
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
}

model TableInvite {
  id          String       @id @default(cuid())
  table       Table        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId     String
  inviter     User         @relation("InvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId   String
  invitee     User         @relation("InvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviteeId   String
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tableId, inviteeId])
  @@index([inviteeId])
  @@index([tableId])
}
